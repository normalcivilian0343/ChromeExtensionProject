{
    "manifest_version": 3,
    "name": "Article Annotator And Notetaking",
    "version": "0.1.0",
    "description": "Annotating directly on articles",
    "permissions": ["storage", "activeTab", "scripting", "contextMenus","aiLanguageModelOriginTrial"
],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "oauth2": {
    "client_id": "YOUR_GOOGLE_CLOUD_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents"
    ]
    },
    
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["actualcontent/content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ],
   "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Article Annotator and Notetaking",
    "default_icon": {
        "16": "bookicon.png",
        "32": "bookicon.png",
        "48": "bookicon.png",
        "128": "bookicon.png"
    }
}
}
 
